# --- Обязательное ---
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=поменяй-на-длинную-случайную-строку
JWT_REFRESH_SECRET=другая-длинная-случайная-строка

# --- База ---
DATABASE_URL="file:./dev.db"
# PostgreSQL: DATABASE_URL="postgresql://photoquest:photoquest@localhost:5432/photoquest"

# --- Сервер ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Модели ИИ ---
AI_MODEL_VISION=claude-sonnet-5
AI_MODEL_TASKS=claude-haiku-4-5-20251001
AI_MODEL_ARBITER=claude-opus-5
AI_TIMEOUT_MS=25000

# --- Правила игры ---
MAX_ATTEMPTS_PER_ASSIGNMENT=3
CONFIDENCE_APPROVE=0.75
CONFIDENCE_ARBITER=0.45
BLUR_MIN_SCORE=40
DUPLICATE_HAMMING=6
TASK_POOL_MIN=60
CAPTURE_TOKEN_TTL_SEC=300

# --- Хранилище ---
STORAGE_DRIVER=local
STORAGE_PATH=./storage/photos
# S3: STORAGE_DRIVER=s3, S3_ENDPOINT=, S3_BUCKET=, S3_KEY=, S3_SECRET=
